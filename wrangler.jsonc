{
  // compatibility_date is PINNED, not current. `vinext deploy` generated this
  // file stamped with the day it ran (2026-08-07), which the local workerd
  // binary does not support -- `npm run dev` failed with "requires
  // compatibility date 2026-08-07, but the newest date supported by this server
  // binary is 2026-05-22". 2026-05-15 is what this project actually built and
  // ran its 426 tests against. Raising it is a deliberate decision that needs a
  // wrangler upgrade first, not a side effect of the date a deploy happened.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alankar-jewellers",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  // GOLD RATE INGEST. Handler and full rationale in worker/index.ts.
  //
  // CRON IS UTC. INDIA IS UTC+5:30. Every time below is written as the UTC
  // instant of an IST wall-clock time, and the half-hour offset is the thing
  // that gets these wrong -- "0 10 * * *" is not 10 AM in Delhi, it is 3:30 PM.
  // India observes no daylight saving, so these are stable all year.
  //
  //   30 4  = 10:00 IST  the shop-opening health check. Nothing new is
  //                      published this early; this exists so a feed that
  //                      broke overnight is visible before the doors open.
  //   40 6  = 12:10 IST  just after IBJA's ~12:05 publication.
  //   40 11 = 17:10 IST  just after IBJA's ~17:05 publication.
  //
  // The two afternoon runs are what keep the storefront priced: a rate expires
  // 90 minutes after the next publication was due, so a 10:00-only schedule
  // would leave the site unable to quote from 13:35 every day.
  //
  // IBJA does not publish at weekends or on bullion holidays. These still fire;
  // the read simply finds no newer slot and writes nothing, which is why the
  // ingest is idempotent on `slotRef`.
  "triggers": {
    "crons": [
      "30 4 * * *",
      "40 6 * * *",
      "40 11 * * *"
    ]
  }
}
