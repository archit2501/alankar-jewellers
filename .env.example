# Copy to `.env` for local dev, and set the same key as a Worker secret /
# environment variable in the hosting control plane for production.
#
# LEAD_WEBHOOK_URL — optional. When set, every appointment request is POSTed to
# this URL as JSON so the shop hears about a lead immediately instead of waiting
# for someone to read the database.
#
# Payload:
#   {"site":"alankar-jewellers","name":"...","phone":"+9198...","interest":"...",
#    "preferredTime":"...","note":null,"userAgent":"...","country":"IN",
#    "receivedAt":"2026-07-26T10:00:00.000Z"}
#
# Where to point it:
#   Zapier — Zaps > Trigger "Webhooks by Zapier" > Catch Hook, copy the URL,
#            then add a Gmail / WhatsApp / Google Sheets action.
#   Make   — Scenario > "Custom webhook" module > Add > copy the address.
#   n8n    — Webhook node (POST), use the Production URL.
#   Email  — any relay that accepts a JSON POST works, e.g. a Resend or
#            SendGrid inbound automation endpoint.
#
# Leave it unset and the site still works: leads are stored in D1 only.
LEAD_WEBHOOK_URL=
