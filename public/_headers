# ============================================================================
# Headers for STATIC files. Cloudflare applies this to everything served from
# dist/client, and serves those files before worker/index.ts runs, so nothing
# in the Worker can set caching on these URLs. HTML and API responses get their
# security headers in the Worker instead.
#
# vinext generates its own _headers ONLY WHEN NONE EXISTS. This file replaces
# it, so its one rule is restated first: hashed build output never changes.
# tests/security-headers.test.mjs fails if the built copy drifts from this one.
# ============================================================================

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Catalogue photographs keep the same filename when they are regenerated (see
# scripts/build-images.mjs), so they must NOT be immutable. A week, then serve
# the cached copy while revalidating: every page view was re-downloading
# 300 KB photographs, and a regraded one still reaches visitors within a week.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Self-hosted typefaces change almost never, but their names are not hashed.
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
