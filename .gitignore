# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Cloudflare local secrets. NOT covered by `.env*` -- different filename, same
# blast radius, and this repo is PUBLIC. It is where the admin password pepper
# and any D1/R2 credentials live during local development, so a single
# `git add -A` on a day this file exists would publish them.
# The precedent is not hypothetical: wrangler.jsonc was committed unnoticed
# exactly that way.
.dev.vars
.dev.vars.*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# D1 dumps. These contain customer names, addresses and PAN, and THIS
# REPOSITORY IS PUBLIC. `scripts/backup-d1.sh` writes here; the encrypted form
# is safe in an artifact but neither form belongs in git.
/backup/
*.sql.enc

# Flick/Remotion ad workspace. Node modules and rendered MP4s do not belong in
# a public site repo; the composition source is copied out when it is kept.
/flick-output/

# Raw shop photographs carry price tags and SKU stickers, and the retouch
# workspace holds codex intermediates. Only the finished webps under
# public/images/catalogue/ are meant for the public repo.
/photoshoot/
